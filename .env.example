#---- database ----
DB_USER=campushub
DB_PASSWORD=change-me
DB_NAME=campushub
DATABASE_URL=postgres://campushub:change-me@localhost:5432/campushub

# ---- api ----
NODE_ENV=development
PORT=3000
SESSION_SECRET=
PUBLIC_URL=http://localhost:5173
# set empirically see campushub-hosting md section 4 never guess
TRUST_PROXY_HOPS=1
# doar cand cloudflare chiar sta in fata oricine poate falsifica antetul altfel
TRUST_CF_CONNECTING_IP=false
# registration is limited to these email domains checked server side
ALLOWED_EMAIL_DOMAINS=tuiasi.ro,student.tuiasi.ro
FACULTY_ID=1

# header based mock auth refused at boot when NODE_ENV=production
DEV_LOGIN=true

# ---- feature flags ----
FEATURE_SCRAPER=false
FEATURE_FLOORPLANS=false
FEATURE_UPLOADS=false
FEATURE_SSE=false
FEATURE_EMAIL_VERIFY=false
FEATURE_EVENTS=true
FEATURE_MODERATION_PANEL=true
FEATURE_ICS_EXPORT=true
# institutional sign in needs the two azure values below to be set
FEATURE_SSO=false
# the password form stays for the demo accounts and the tests set false in production
FEATURE_PASSWORD_LOGIN=true
# signing up is not the same decision as signing in nothing verifies the address yet so the form
# is for development only left unset it is on outside production and off inside it
FEATURE_REGISTRATION=true

# ---- microsoft entra id sign in ----
# tenant of the university discovered from the domain itself both tuiasi domains live in it
AZURE_TENANT_ID=607d63ca-9f36-4ad8-9f71-8b3efc392eb1
# from the app registration in your own tenant marked multi tenant
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# has to match a redirect uri registered on the app to the character
AZURE_REDIRECT_URI=http://localhost:5173/api/v1/auth/sso/callback
# optional skips the microsoft account picker and goes straight to sso.tuiasi.ro
AZURE_DOMAIN_HINT=

# ---- demo accounts ----
# the two accounts the seed writes with a password: admin@tuiasi.ro and student@student.tuiasi.ro
# no password literal lives in the repository so the seed refuses to run without these
# locally anything over 12 characters does; on a reachable host generate them:
#   openssl rand -base64 18
DEMO_ADMIN_PASSWORD=
DEMO_STUDENT_PASSWORD=

# ---- deployment host only ----
COMPOSE_PROJECT_NAME=campushub-prod
GH_ORG=
TAG=
TUNNEL_TOKEN=
UPTIME_KUMA_PUSH_URL=
