{
  "name": "campushub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @campushub/shared && npm run build -w @campushub/api",
    "dev": "npm run dev -w @campushub/api",
    "typecheck": "npm run build -w @campushub/shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @campushub/api",
    "db:seed": "npm run db:seed -w @campushub/api",
    "db:check": "npm run db:check -w @campushub/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
